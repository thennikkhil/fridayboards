# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# URL for your Convex project (starts with https://...)
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication (from https://dashboard.clerk.com/last-active?path=api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT Issuer Domain for Convex (e.g. https://xxxx-xxxx.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# Liveblocks Real-Time Multiplayer (from https://liveblocks.io/dashboard/apikeys)
LIVEBLOCKS_SECRET_KEY=

